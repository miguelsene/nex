# Porta em que o servidor HTTP/Socket.IO vai rodar
PORT=4000

# URL(s) do frontend autorizadas a se conectar (separe por vírgula se houver mais de uma)
CLIENT_URL=http://localhost:5173

# --- Configuração ICE (STUN/TURN) ---
# STUN público usado por padrão (não precisa alterar em desenvolvimento)
STUN_URL=stun:stun.l.google.com:19302

# TURN (opcional, recomendado em produção para redes restritivas / atrás de NAT simétrico / CGNAT)
# Deixe em branco em desenvolvimento. Preencha ao publicar o projeto.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Tempo (ms) que uma sala vazia aguarda antes de ser removida da memória
ROOM_CLEANUP_DELAY_MS=15000
